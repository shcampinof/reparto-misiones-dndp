NODE_ENV=development
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Obligatorio en produccion (minimo 32 caracteres). En desarrollo, si se deja
# vacio, la API genera un secreto efimero que cambia al reiniciar.
JWT_SECRET=

# Persistencia de pruebas previa a Oracle. Ruta fuera del paquete público.
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/sigip.sqlite
ENABLE_PROVISIONAL_RULES=true
DEMO_RESET_ON_START=false

# El modo demo solo se permite en development/test y debe habilitarse de forma
# explícita. Usa únicamente identidades sintéticas precargadas, sin contraseñas.
ENABLE_DEMO_ACCOUNTS=false

# Habilitacion global por rol. Si un rol queda en false, sus cuentas no aparecen.
ENABLE_ROLE_ADMINISTRADOR=true
ENABLE_ROLE_DEFENSOR=true
ENABLE_ROLE_INVESTIGADOR=true
ENABLE_ROLE_PAG_INVESTIGACION=true
ENABLE_ROLE_RJV=true
ENABLE_ROLE_PAG_VICTIMAS=true
ENABLE_ROLE_PERITO=true

# Perfiles conservadores de presentación; las actuaciones siguen sujetas a RACI.
ENABLE_ROLE_GESTOR_OPERATIVO_REGIONAL=true
ENABLE_ROLE_GESTOR_CENTRAL_EXCEPCIONES=true
ENABLE_ROLE_DEFENSOR_REGIONAL=true

# Límites técnicos de archivos para pruebas, sin aprobación institucional
FILE_MAX_MB=10
INTAKE_MAX_MB=30
ITEM_FILES_MAX_MB=50
JSON_MAX_MB=48
# Opcional: ruta del ejecutable clamscan con firmas actualizadas en este host
ANTIMALWARE_COMMAND=
REQUIRE_ANTIMALWARE=false
# Usar volumen duradero; una copia en disco efímero también se pierde
BACKUP_DIRECTORY=./data/backups
BACKUP_INTERVAL_MINUTES=360
BACKUP_KEEP=3
