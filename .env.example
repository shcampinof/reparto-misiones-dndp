NODE_ENV=development
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seleccione exactamente uno de estos pares:
# presentation + sqlite | institutional + oracle
APP_PROFILE=presentation
PERSISTENCE_DRIVER=sqlite

# Perfil presentation. La ruta puede apuntar a almacenamiento efímero en el Space.
SQLITE_PATH=data/sigip-presentation.sqlite
DEMO_RESET_ON_START=false
ENABLE_DEMO_ACCOUNTS=false

# Obligatorio en producción (mínimo 32 caracteres). No confirme valores reales.
JWT_SECRET=

# Perfil institutional. Todos los valores se inyectan por variables o secretos.
# Use una cuenta propietaria dedicada; nunca SYS, SYSTEM ni un esquema compartido.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=8
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_QUEUE_TIMEOUT=15000
ORACLE_STATEMENT_CACHE_SIZE=30

# Debe permanecer false salvo durante una migración aprobada en el esquema objetivo.
ALLOW_ORACLE_MIGRATION=false

# Habilitación global por rol. Los roles propuestos no se activan por estas variables.
ENABLE_ROLE_ADMINISTRADOR=true
ENABLE_ROLE_DEFENSOR=true
ENABLE_ROLE_INVESTIGADOR=true
ENABLE_ROLE_PAG_INVESTIGACION=true
ENABLE_ROLE_RJV=true
ENABLE_ROLE_PAG_VICTIMAS=true
ENABLE_ROLE_PERITO=true
ENABLE_ROLE_PAG_CENTRAL=false
ENABLE_ROLE_ADMINISTRADOR_REGIONAL=false
ENABLE_ROLE_DEFENSOR_REGIONAL=false
