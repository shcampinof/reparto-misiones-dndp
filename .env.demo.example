NODE_ENV=development
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=demo-presentacion
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo explícita: no usar en producción. No requiere contraseñas porque la
# pantalla ofrece ingreso rápido únicamente con identidades sintéticas.
ENABLE_DEMO_ACCOUNTS=true
JWT_SECRET=
STORAGE_DRIVER=sqlite
SQLITE_PATH=./data/sigip.sqlite
ENABLE_PROVISIONAL_RULES=true
DEMO_RESET_ON_START=false

# Límites técnicos de archivos para pruebas, sin aprobación institucional
FILE_MAX_MB=10
INTAKE_MAX_MB=30
ITEM_FILES_MAX_MB=50
JSON_MAX_MB=48
# Opcional: ruta del ejecutable clamscan con firmas actualizadas en este host
ANTIMALWARE_COMMAND=
REQUIRE_ANTIMALWARE=false
# Usar volumen duradero; una copia en disco efímero también se pierde
BACKUP_DIRECTORY=./data/backups
BACKUP_INTERVAL_MINUTES=360
BACKUP_KEEP=3
