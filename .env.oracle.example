# Oracle Linux: copiar a .env.oracle y completar únicamente en el servidor.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=oracle-development
LOG_LEVEL=info
STORAGE_DRIVER=oracle

# PENDIENTE DBA: usuario de un esquema de DESARROLLO dedicado y contraseña.
# Descomentar las dos líneas cuando se entreguen los accesos.
# ORACLE_USER=
# ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host-oracle:1531/servicio
ORACLE_POOL_MIN=0
ORACLE_POOL_MAX=4
ORACLE_QUEUE_TIMEOUT_MS=15000
ORACLE_CALL_TIMEOUT_MS=30000
# Sólo tras revisar con DBA el mapeo de un esquema que contenga tablas ajenas.
ORACLE_ALLOW_EXISTING_SCHEMA=false

# Sólo si el DBA exige TLS/wallet. Thin no necesita Instant Client.
# ORACLE_CONFIG_DIR=/ruta/privada/config
# ORACLE_WALLET_LOCATION=/ruta/privada/wallet
# ORACLE_WALLET_PASSWORD=

# Sin semillas personales por defecto. Para demostración en ESQUEMA AISLADO:
# cambiar juntos ORACLE_SEED_DEMO y ENABLE_DEMO_ACCOUNTS a true.
ORACLE_SEED_DEMO=false
ENABLE_DEMO_ACCOUNTS=false
ENABLE_PROVISIONAL_RULES=false
DEMO_RESET_ON_START=false

# El instalador genera JWT_SECRET aleatorio sin imprimirlo.
JWT_SECRET=
# El instalador completa STATIC_DIR con la ruta absoluta del frontend.
STATIC_DIR=
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
FILE_MAX_MB=10
INTAKE_MAX_MB=30
ITEM_FILES_MAX_MB=50
JSON_MAX_MB=48
ANTIMALWARE_COMMAND=
REQUIRE_ANTIMALWARE=false
# Oracle usa la política de respaldo del DBA; nunca el respaldo SQLite.
BACKUP_DIRECTORY=

# PENDIENTE INSTITUCIONAL: SSO, correo, IRIS, SharePoint y antimalware.
# Estos proveedores no se activan agregando variables sin un adaptador validado.
