NODE_ENV=development
APP_PROFILE=presentation
PERSISTENCE_DRIVER=sqlite
SQLITE_PATH=data/sigip-presentation.sqlite
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=demo-presentacion
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo explícita: no usar en producción. No requiere contraseñas porque la
# pantalla ofrece ingreso rápido únicamente con identidades sintéticas.
ENABLE_DEMO_ACCOUNTS=true
DEMO_RESET_ON_START=true
JWT_SECRET=
