NODE_ENV=development
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Obligatorio en produccion (minimo 32 caracteres). En desarrollo, si se deja
# vacio, la API genera un secreto efimero que cambia al reiniciar.
JWT_SECRET=

# El modo demo solo se permite en development/test y debe habilitarse de forma
# explícita. Usa únicamente identidades sintéticas precargadas, sin contraseñas.
ENABLE_DEMO_ACCOUNTS=false

# Habilitacion global por rol. Si un rol queda en false, sus cuentas no aparecen.
ENABLE_ROLE_ADMINISTRADOR=true
ENABLE_ROLE_DEFENSOR=true
ENABLE_ROLE_INVESTIGADOR=true
ENABLE_ROLE_PAG_INVESTIGACION=true
ENABLE_ROLE_RJV=true
ENABLE_ROLE_PAG_VICTIMAS=true
ENABLE_ROLE_PERITO=true

# Roles propuestos pendientes de matrices RACI separadas. Permanecen inactivos.
ENABLE_ROLE_PAG_CENTRAL=false
ENABLE_ROLE_ADMINISTRADOR_REGIONAL=false
ENABLE_ROLE_DEFENSOR_REGIONAL=false
