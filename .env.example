NODE_ENV=development
PORT=4000
SERVICE_NAME=sigip-dp-api
SERVICE_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Obligatorio en produccion (minimo 32 caracteres). En desarrollo, si se deja
# vacio, la API genera un secreto efimero que cambia al reiniciar.
JWT_SECRET=

# El modo demo solo se permite en development/test y debe habilitarse de forma
# explicita. Configure al menos una contrasena si lo activa.
ENABLE_DEMO_ACCOUNTS=false

# Habilitacion global por rol. Si un rol queda en false, sus cuentas no aparecen.
ENABLE_ROLE_ADMINISTRADOR=true
ENABLE_ROLE_COORDINADOR=true
ENABLE_ROLE_PAG=true
ENABLE_ROLE_ADMINISTRATIVO_DELEGADO=true
ENABLE_ROLE_DEFENSOR=true
ENABLE_ROLE_INVESTIGADOR=true
ENABLE_ROLE_DEFENSOR_REGIONAL=true
ENABLE_ROLE_PAG_UNIDAD_OPERATIVA=true

# Credenciales demo principales solicitadas.
DEMO_ADMIN_USER=admin
DEMO_ADMIN_PASSWORD=
DEMO_ADMIN_NAME=Administrador

# Cuenta generica configurable. Por defecto entra como defensor.
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Usuario Demo
DEMO_USER_EMAIL=usuario.demo@defensoria.gov.co
DEMO_USER_ROLE=defensor
